---
import PageHead from '../components/shared/PageHead.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
// Static shell only. F6/F7 will supply Auth and owner authorization through RLS.
---

<!doctype html>
<html lang="es">
  <head><PageHead title={title} description="Administración del portfolio." /></head>
  <body>
    <a class="skip-link" href="#contenido-admin">Saltar al contenido</a>
    <main id="contenido-admin" tabindex="-1"><slot /></main>
  </body>
</html>

---
import { fileURLToPath } from 'node:url';
import { outDir } from 'astro:config/server';
import HomePage from '../components/public/HomePage.astro';
import { getPublicConfig } from '../lib/config/public.ts';
import { loadHomePage } from '../lib/content/home-build.ts';
// A failure deliberately aborts static generation; no empty or cached fallback.
const home = await loadHomePage(getPublicConfig(), fileURLToPath(outDir));
---

<HomePage home={home} />

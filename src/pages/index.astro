---
import Badge from '../components/shared/Badge.astro';
import BrandMark from '../components/shared/BrandMark.astro';
import Button from '../components/shared/Button.astro';
import Feedback from '../components/shared/Feedback.astro';
import FormField from '../components/shared/FormField.astro';
import GlassCard from '../components/shared/GlassCard.astro';
import Icon from '../components/shared/Icon.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import '../styles/admin.css';
---

<PublicLayout
  title="Sistema visual AL — Alonso Larenas"
  description="Infraestructura visual del portfolio personal de Alonso Larenas."
>
  <div class="design-foundation" data-testid="design-foundation">
    <section class="foundation-intro container" aria-labelledby="page-title">
      <div class="brand-lockup" data-reveal>
        <BrandMark size={48} />
        <span>AL — Alonso Larenas</span>
      </div>

      <Badge tone="cyan" icon="sparkles">Design System · Fase 2</Badge>

      <div class="foundation-heading" data-reveal data-reveal-delay="80">
        <h1 id="page-title">Sistema visual AL</h1>
        <p class="foundation-lead">
          Tipografía precisa, profundidad medida y acentos eléctricos para una experiencia
          tecnológica, limpia y profesional.
        </p>
        <p>La infraestructura visual está lista para construir el portfolio.</p>
      </div>

      <div class="foundation-actions" data-reveal data-reveal-delay="140">
        <Button href="#componentes" arrow>Acción principal</Button>
        <Button variant="secondary">Acción secundaria</Button>
        <Button href="#principios" variant="ghost" arrow>Ver principios</Button>
      </div>
    </section>

    <section
      id="principios"
      class="foundation-section container"
      aria-labelledby="principles-title"
    >
      <div data-reveal>
        <SectionHeader
          eyebrow="Dirección visual"
          title="El contenido conserva el protagonismo."
          description="Glass, glow y movimiento construyen jerarquía y profundidad solo cuando aportan contexto."
        />
      </div>

      <div class="principles-grid">
        <article data-reveal>
          <span class="principle-number">01</span>
          <h3>Jerarquía clara</h3>
          <p>Space Grotesk ordena los hitos; Manrope mantiene la lectura natural.</p>
        </article>
        <article data-reveal data-reveal-delay="70">
          <span class="principle-number">02</span>
          <h3>Profundidad selectiva</h3>
          <p>Las superficies translúcidas señalan acciones y contenido prioritario.</p>
        </article>
        <article data-reveal data-reveal-delay="140">
          <span class="principle-number">03</span>
          <h3>Movimiento útil</h3>
          <p>
            Las transiciones acompañan la interacción y desaparecen al solicitar movimiento
            reducido.
          </p>
        </article>
      </div>
    </section>

    <section
      id="componentes"
      class="foundation-section container"
      aria-labelledby="components-title"
    >
      <div data-reveal>
        <SectionHeader
          eyebrow="Componentes base"
          title="Un lenguaje consistente para cada interacción."
          description="La muestra valida superficies, controles y feedback. Será reemplazada por el contenido real en F3."
        />
      </div>

      <div class="component-grid">
        <GlassCard level="strong" interactive class="feature-card">
          <div class="feature-card__icon"><Icon name="layers" size={24} /></div>
          <Badge tone="violet">Glass strong · selectivo</Badge>
          <h3>Profundidad sin ruido</h3>
          <p>
            Una superficie protagonista combina borde tenue, blur controlado y una iluminación
            reactiva limitada al puntero fino.
          </p>
          <div class="metric-row" aria-label="Características verificadas">
            <span><strong>24px</strong> blur máximo</span>
            <span><strong>3°</strong> tilt máximo</span>
          </div>
        </GlassCard>

        <GlassCard level="standard" class="form-card">
          <div class="technical-label">Field / error</div>
          <h3>Formulario legible</h3>
          <FormField
            id="sample-email"
            name="sample-email"
            type="email"
            label="Correo de muestra"
            placeholder="nombre@dominio.cl"
            autocomplete="email"
            error="Revisa el formato antes de continuar."
            required
          />
        </GlassCard>

        <GlassCard level="subtle" class="state-card">
          <div class="technical-label">States / feedback</div>
          <Feedback tone="success" title="Sistema disponible">
            <p>El mensaje combina icono, texto y color para comunicar su estado.</p>
          </Feedback>
          <div class="state-actions">
            <Button loading>Procesando</Button>
            <Button variant="secondary" disabled>No disponible</Button>
          </div>
        </GlassCard>

        <div class="admin-shell admin-preview" data-reveal>
          <div class="admin-panel admin-preview__panel">
            <div>
              <p class="technical-label">Admin foundation</p>
              <h3>Mayor densidad, menor intensidad.</h3>
            </div>
            <Badge tone="cyan" icon="terminal">Productivo</Badge>
          </div>
        </div>
      </div>
    </section>
  </div>
</PublicLayout>

<style>
  .design-foundation {
    overflow: clip;
  }

  .foundation-intro {
    display: grid;
    min-height: min(780px, 100svh);
    align-content: center;
    justify-items: start;
    gap: var(--space-24);
    padding-block: var(--space-96);
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .foundation-heading {
    display: grid;
    max-width: 920px;
    gap: var(--space-24);
  }

  .foundation-lead {
    max-width: 720px;
    color: var(--text-secondary);
    font-size: var(--font-size-body-lg);
    line-height: 1.65;
  }

  .foundation-heading > p:last-child {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .foundation-actions,
  .state-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  .foundation-section {
    display: grid;
    gap: var(--space-64);
    padding-block: var(--section-space);
  }

  .principles-grid {
    display: grid;
    gap: var(--space-32);
  }

  .principles-grid article {
    display: grid;
    gap: var(--space-12);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }

  .principle-number {
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .principles-grid p {
    max-width: 42ch;
    color: var(--text-muted);
  }

  .component-grid {
    display: grid;
    gap: var(--space-24);
  }

  :global(.feature-card),
  :global(.form-card),
  :global(.state-card) {
    display: grid;
    align-content: start;
    gap: var(--space-24);
    padding: var(--space-24);
  }

  .feature-card__icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgb(var(--accent-cyan-rgb) / 0.26);
    border-radius: var(--radius-sm);
    background: rgb(var(--accent-cyan-rgb) / 0.08);
    color: var(--accent-cyan);
  }

  :global(.feature-card) > p {
    max-width: 58ch;
    color: var(--text-secondary);
  }

  .metric-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
    padding-top: var(--space-8);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .metric-row span {
    display: grid;
    gap: var(--space-4);
  }

  .metric-row strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .admin-preview {
    padding: var(--space-16);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .admin-preview__panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
    padding: var(--space-24);
  }

  .admin-preview__panel > div {
    display: grid;
    gap: var(--space-8);
  }

  @media (max-width: 47.99rem) {
    .foundation-intro {
      min-height: auto;
      padding-block: var(--space-80);
    }

    .foundation-actions,
    .foundation-actions :global([data-ui-button]) {
      width: 100%;
    }

    .foundation-section {
      gap: var(--space-48);
    }

    .admin-preview__panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (min-width: 48rem) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    :global(.feature-card),
    :global(.form-card),
    :global(.state-card) {
      padding: var(--space-32);
    }
  }

  @media (min-width: 64rem) {
    .component-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    :global(.feature-card) {
      grid-column: span 7;
    }

    :global(.form-card) {
      grid-column: span 5;
    }

    :global(.state-card) {
      grid-column: span 5;
    }

    .admin-preview {
      grid-column: span 7;
    }
  }
</style>

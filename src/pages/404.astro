---
import { fileURLToPath } from 'node:url';
import { outDir } from 'astro:config/server';
import InternalLayout from '../layouts/InternalLayout.astro';
import PageHero from '../components/public/PageHero.astro';
import { loadPublicPages } from '../lib/content/public-build.ts';
import { pageSeo } from '../lib/content/pages.ts';
import { getPublicConfig } from '../lib/config/public.ts';
const content = await loadPublicPages(getPublicConfig(), fileURLToPath(outDir));
---

<InternalLayout
  content={content}
  seo={{
    ...pageSeo(content, '/404.html', 'Página no encontrada', 'La página solicitada no existe.'),
    robots: 'noindex,nofollow',
  }}
>
  <PageHero
    eyebrow="404 / Otra dirección"
    title="Página no encontrada"
    description="Revisa la dirección o vuelve al inicio."
    ><div class="page-actions">
      <a class="text-link" href={content.links.home}>Volver al inicio</a>
    </div></PageHero
  >
</InternalLayout>

---
interface Props {
  id: string;
  name?: string;
  type?: 'text' | 'email' | 'url' | 'search' | 'password';
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  describedBy?: string | undefined;
}

const {
  id,
  name = id,
  type = 'text',
  placeholder,
  autocomplete,
  required = false,
  disabled = false,
  invalid = false,
  describedBy,
} = Astro.props;
---

<input
  class="input"
  {id}
  {name}
  {type}
  {placeholder}
  {autocomplete}
  {required}
  {disabled}
  aria-invalid={invalid ? 'true' : undefined}
  aria-describedby={describedBy}
/>

<style>
  .input {
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: rgb(var(--midnight-950-rgb) / 0.54);
    color: var(--text-primary);
    caret-color: var(--accent-cyan);
    transition:
      border-color var(--duration-normal) var(--ease-premium),
      background-color var(--duration-normal) var(--ease-premium),
      box-shadow var(--duration-normal) var(--ease-premium);
  }

  .input::placeholder {
    color: var(--text-muted);
  }

  .input:hover:not(:disabled) {
    border-color: var(--border-hover);
  }

  .input:focus {
    border-color: var(--accent-cyan);
    background: rgb(var(--midnight-950-rgb) / 0.72);
  }

  .input[aria-invalid='true'] {
    border-color: var(--accent-magenta);
  }

  .input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>

---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  arrow?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  disabled = false,
  loading = false,
  arrow = false,
  class: className,
} = Astro.props;
const inactive = disabled || loading;
const classes = ['button', `button--${variant}`, className];
---

{
  href ? (
    <a
      class:list={classes}
      href={inactive ? undefined : href}
      aria-disabled={inactive ? 'true' : undefined}
      aria-busy={loading ? 'true' : undefined}
      tabindex={inactive ? -1 : undefined}
      data-ui-button
    >
      {loading && <Icon name="loader" class="button__loader" />}
      <span>
        <slot />
      </span>
      {arrow && <Icon name="arrow-right" class="button__arrow" />}
    </a>
  ) : (
    <button
      class:list={classes}
      type={type}
      disabled={inactive}
      aria-busy={loading ? 'true' : undefined}
      data-ui-button
    >
      {loading && <Icon name="loader" class="button__loader" />}
      <span>
        <slot />
      </span>
      {arrow && <Icon name="arrow-right" class="button__arrow" />}
    </button>
  )
}

<style>
  .button {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: 11px var(--space-24);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1.3;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--duration-micro) var(--ease-premium),
      border-color var(--duration-normal) var(--ease-premium),
      background-color var(--duration-normal) var(--ease-premium),
      box-shadow var(--duration-normal) var(--ease-premium);
  }

  .button--primary {
    border-color: rgb(var(--text-primary-rgb) / 0.18);
    background-color: var(--accent-cyan);
    background-image: var(--gradient-brand);
    box-shadow: 0 12px 32px rgb(var(--accent-blue-rgb) / 0.18);
    color: var(--midnight-950);
  }

  .button--secondary {
    border-color: var(--border-subtle);
    background: var(--glass-standard);
    box-shadow: inset 0 1px 0 rgb(var(--text-primary-rgb) / 0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .button--ghost {
    padding-inline: var(--space-12);
    background: transparent;
    color: var(--text-secondary);
  }

  .button:not(:disabled, [aria-disabled='true']):hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .button--secondary:not(:disabled, [aria-disabled='true']):hover {
    background: var(--glass-strong);
  }

  .button--ghost:not(:disabled, [aria-disabled='true']):hover {
    color: var(--text-primary);
  }

  .button:not(:disabled, [aria-disabled='true']):active {
    transform: scale(0.98);
  }

  .button:disabled,
  .button[aria-disabled='true'] {
    opacity: 0.48;
    cursor: not-allowed;
  }

  .button :global(.button__arrow) {
    transition: transform var(--duration-normal) var(--ease-premium);
  }

  .button:hover :global(.button__arrow) {
    transform: translateX(3px);
  }

  .button :global(.button__loader) {
    animation: loader-turn 900ms linear infinite;
  }

  @keyframes loader-turn {
    to {
      transform: rotate(360deg);
    }
  }
</style>

---
import { resolveMedia } from '../../lib/media/build-assets.ts';
import type { AssetMap } from '../../lib/media/build-assets.ts';
interface Props {
  assets: AssetMap;
  assetId: string;
  sizes?: string;
  eager?: boolean;
}
const { assets, assetId, sizes = '(max-width: 760px) 100vw, 960px', eager = false } = Astro.props;
const asset = resolveMedia(assets, assetId);
if (!asset.width || !asset.height || !asset.variants.length)
  throw new Error('MediaImage requires a built image.');
const srcset = (format: 'avif' | 'webp') =>
  asset.variants
    .filter((variant) => variant.format === format)
    .map((variant) => variant.src + ' ' + variant.width + 'w')
    .join(', ');
---

<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt={asset.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>
<style>
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>

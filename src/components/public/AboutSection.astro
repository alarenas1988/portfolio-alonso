---
import type { HomeModel } from '../../lib/content/home.ts';
import MediaImage from '../shared/MediaImage.astro';
import Icon from '../shared/Icon.astro';
import { createUrlHelpers } from '../../lib/utils/urls.ts';
import { getPublicConfig } from '../../lib/config/public.ts';
interface Props {
  home: HomeModel;
}
const { home } = Astro.props;
const { withBase } = createUrlHelpers(getPublicConfig().siteUrl);
---

<section
  id="sobre-mi"
  class="home-section container about"
  aria-labelledby="about-title"
  data-section="about"
>
  <div class="about__copy" data-reveal>
    <p class="technical-label"><span>02 /</span> Sobre mí</p><h2 id="about-title">
      {home.about.summary || 'Sobre mí'}
    </h2>{
      home.settings.professional_title && (
        <p class="about__specialization">{home.settings.professional_title}</p>
      )
    }{home.about.method && <p>{home.about.method}</p>}{
      home.principles.length > 0 && (
        <a class="text-link" href={withBase('/#principios')}>
          Mi forma de trabajar
          <Icon name="arrow-right" size={18} />
        </a>
      )
    }{
      home.about.imageId && (
        <div class="about__image">
          <MediaImage
            assets={home.assets}
            assetId={home.about.imageId}
            sizes="(min-width: 768px) 45vw, 100vw"
          />
        </div>
      )
    }
  </div>
  {
    home.principles.length > 0 && (
      <div id="principios" class="about__principles" data-reveal>
        <>
          <h3>Cómo entiendo el trabajo.</h3>
          <ol>
            {home.principles.map((principle) => (
              <li>
                <span class="about__number" aria-hidden="true">
                  {String(principle.number).padStart(2, '0')}
                </span>
                <div>
                  <p>{principle.title}</p>
                  {principle.description && <small>{principle.description}</small>}
                </div>
              </li>
            ))}
          </ol>
        </>
      </div>
    )
  }
</section>
<style>
  .about {
    border-top: 1px solid var(--border-subtle);
  }
  .about__copy {
    display: grid;
    align-content: start;
    gap: var(--space-24);
  }
  .about__copy .technical-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }
  .technical-label span {
    color: var(--accent-cyan);
    margin-right: var(--space-12);
  }
  h2 {
    max-width: 22ch;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 1.18;
  }
  .about__copy > p:not(.technical-label) {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .about__specialization {
    font-size: 0.8125rem !important;
  }
  .about__image {
    max-width: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .about__principles h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-24);
    letter-spacing: -0.02em;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: start;
    gap: var(--space-24);
    padding-block: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  li p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
  li small {
    display: block;
    margin-top: var(--space-8);
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .about__number {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent-cyan);
    padding-top: 4px;
  }
  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-64);
    }
    .about__principles {
      padding-top: var(--space-32);
    }
  }
</style>

---
interface Props {
  items: { label: string; href?: string }[];
}
---

<nav class="breadcrumbs" aria-label="Ruta de navegación">
  <ol>
    {
      Astro.props.items.map((item) => (
        <li>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

---
import Icon from '../shared/Icon.astro';
interface Props {
  message: string;
}
const { message } = Astro.props;
---

<div class="editorial-empty" data-empty-state>
  <Icon name="arrow-up-right" size={20} /><p>{message}</p><span class="technical-label"
    >En preparación</span
  >
</div>
<style>
  .editorial-empty {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    min-height: 100px;
    padding: var(--space-24) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .editorial-empty :global(.icon) {
    color: var(--text-muted);
  }
  .editorial-empty p {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .editorial-empty .technical-label {
    margin-left: auto;
    white-space: nowrap;
    font-size: 0.625rem;
    color: var(--text-muted);
  }
  @media (max-width: 47.99rem) {
    .editorial-empty {
      flex-wrap: wrap;
    }
    .editorial-empty p {
      flex: 1;
    }
    .editorial-empty .technical-label {
      flex-basis: 100%;
      padding-left: 36px;
      margin-left: 0;
    }
  }
</style>

---
import BrandMark from '../shared/BrandMark.astro';
import Button from '../shared/Button.astro';
import HeroVisual from './HeroVisual.astro';
import type { HomeModel } from '../../lib/content/home.ts';
interface Props {
  home: HomeModel;
}
const { home } = Astro.props;
const words = home.settings.hero_title!.trim().split(/\s+/);
const lead = words.slice(0, -2).join(' '),
  ending = words.slice(-2).join(' ');
---

<section class="hero container" id="inicio" aria-labelledby="home-title">
  <div class="hero__copy">
    <div class="hero__identity">
      <span class="hero-stage" style="--hero-delay:0ms"><BrandMark size={44} /></span><span
        class="hero-stage technical-label"
        style="--hero-delay:100ms">Portfolio profesional</span
      >
    </div>
    <p class="hero__name hero-stage" style="--hero-delay:200ms">{home.settings.site_name}</p>
    <h1 id="home-title" class="hero-stage" style="--hero-delay:300ms">
      {lead ? `${lead} ` : ''}
      <span>{ending}</span>
    </h1>
    <div class="hero__description hero-stage" style="--hero-delay:450ms">
      {
        home.settings.hero_subtitle && (
          <p class="hero__disciplines">{home.settings.hero_subtitle}</p>
        )
      }
      {home.settings.hero_description && <p>{home.settings.hero_description}</p>}
    </div>
    <div class="hero__actions hero-stage" style="--hero-delay:600ms">
      <Button href={home.links.projects} arrow>Explorar proyectos</Button><Button
        href={home.links.contact}
        variant="secondary">Contactarme</Button
      >
    </div>
    {
      home.settings.availability_enabled && home.settings.availability_text && (
        <p class="hero__availability">
          <span aria-hidden="true" />
          {home.settings.availability_text}
        </p>
      )
    }
  </div>
  <div class="hero__visual hero-stage" style="--hero-delay:700ms"><HeroVisual /></div>
  <div class="hero__baseline">
    <span class="technical-label">Ideas que se convierten en soluciones.</span><a
      href={home.links.projects}
      aria-label="Ir a proyectos destacados"
      ><span aria-hidden="true">↓</span><span>Explorar</span></a
    >
  </div>
</section>
<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-32);
    padding-top: var(--space-128);
    padding-bottom: var(--space-32);
  }
  .hero__copy {
    min-width: 0;
  }
  .hero__identity {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    margin-bottom: var(--space-32);
  }
  .hero__identity .technical-label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }
  .hero__name {
    margin-bottom: var(--space-16);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    color: var(--text-secondary);
    letter-spacing: -0.035em;
  }
  h1 {
    max-width: 12ch;
    font-size: min(var(--font-size-h1), 4.5rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  h1 span {
    color: var(--accent-cyan);
  }
  .hero__description {
    max-width: 48ch;
    display: grid;
    gap: var(--space-16);
    margin-top: var(--space-24);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .hero__description p {
    color: var(--text-muted);
  }
  .hero__description .hero__disciplines {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-top: var(--space-32);
  }
  .hero__availability {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: var(--space-24);
  }
  .hero__availability span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan);
  }
  .hero__visual {
    align-self: center;
    min-width: 0;
  }
  .hero__baseline {
    grid-column: 1/-1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-24);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  .hero__baseline .technical-label {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
  }
  .hero__baseline a {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-height: 44px;
    text-decoration: none;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .hero__baseline a > span:first-child {
    font-size: 1.3rem;
    color: var(--accent-cyan);
  }
  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      column-gap: var(--space-16);
      padding-top: var(--space-160);
    }
    h1 {
      max-width: 14ch;
    }
    .hero__baseline {
      margin-top: var(--space-48);
    }
  }
  @media (min-width: 64rem) {
    .hero {
      min-height: 780px;
      grid-template-columns: 1.12fr 1fr;
      column-gap: var(--space-32);
    }
    .hero__identity {
      margin-bottom: var(--space-32);
    }
    h1 {
      max-width: 13ch;
    }
    .hero__description {
      margin-top: var(--space-32);
    }
    .hero__visual {
      margin-inline: -8px;
    }
  }
  @media (max-width: 47.99rem) {
    .hero__actions :global(.button) {
      padding-inline: var(--space-16);
      font-size: 0.8125rem;
    }
    .hero__visual {
      width: min(100%, 400px);
      justify-self: center;
      margin-top: calc(-1 * var(--space-24));
    }
    .hero__baseline .technical-label {
      max-width: 24ch;
    }
    .hero__baseline {
      gap: var(--space-16);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-stage {
      animation: hero-enter var(--duration-premium) var(--ease-premium) var(--hero-delay) both;
    }
    @keyframes hero-enter {
      from {
        transform: translateY(12px);
      }
      to {
        transform: translateY(0);
      }
    }
  }
</style>

---
interface Props {
  label: string;
  title: string;
  description: string;
  href: string;
  action: string;
}
const { label, title, description, href, action } = Astro.props;
---

<div class="editorial-empty" data-editorial-empty>
  <span class="editorial-empty__mark" aria-hidden="true">↗</span>
  <div>
    <p class="technical-label">{label}</p><h2>{title}</h2><p>{description}</p><a
      class="text-link"
      href={href}>{action} <span aria-hidden="true">→</span></a
    >
  </div>
</div>

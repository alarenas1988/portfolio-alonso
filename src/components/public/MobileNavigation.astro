---
import Icon from '../shared/Icon.astro';
import type { HomeModel } from '../../lib/content/home.ts';
interface Props {
  home: HomeModel;
  activeHref?: string;
}
const { home, activeHref } = Astro.props;
const items = [
  ['Inicio', home.links.home],
  ['Proyectos', home.links.projects],
  ['Blog', home.links.blog],
  ['Sobre mí', home.links.about],
  ['Contacto', home.links.contact],
];
---

<details class="mobile-navigation" data-mobile-navigation>
  <summary role="button" aria-label="Abrir menú"
    ><span>Menú</span><Icon name="menu" size={20} /></summary
  >
  <div class="mobile-navigation__panel" data-mobile-panel>
    <div class="mobile-navigation__top">
      <span class="technical-label">{home.settings.brand_short} / Explora</span>
      <button type="button" data-close-menu aria-label="Cerrar menú" hidden
        ><Icon name="close" size={24} /></button
      >
    </div>
    <nav aria-label="Navegación móvil">
      <ul>
        {
          items.map(([label, href], i) => (
            <li>
              <a href={href} aria-current={href === activeHref ? 'page' : undefined}>
                <span class="mobile-navigation__number" aria-hidden="true">
                  0{i + 1}
                </span>
                {label}
                <Icon name="arrow-up-right" size={24} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      home.socialLinks.length > 0 && (
        <div class="mobile-navigation__social">
          {home.socialLinks
            .filter((link) => ['github', 'linkedin'].includes(link.platform.toLowerCase()))
            .map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
                <Icon name="arrow-up-right" size={16} />
              </a>
            ))}
        </div>
      )
    }
  </div>
</details>
<style>
  .mobile-navigation__panel nav a[aria-current='page'] {
    color: var(--accent-cyan);
  }
  .mobile-navigation summary {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-height: 44px;
    padding: var(--space-8) var(--space-12);
    list-style: none;
    cursor: pointer;
    color: var(--text-primary);
    font-size: 0.875rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .mobile-navigation__panel {
    padding: var(--space-24);
    background: var(--midnight-900);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }
  .mobile-navigation[open] .mobile-navigation__panel {
    position: absolute;
    inset: 70px var(--page-gutter) auto;
  }
  .mobile-navigation__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-32);
  }
  button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
    background: var(--glass-standard);
    color: var(--text-primary);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  button[hidden] {
    display: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--border-subtle);
  }
  nav a {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    min-height: 72px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 6vw, 2.5rem);
    letter-spacing: -0.04em;
  }
  nav a :global(.icon) {
    margin-left: auto;
    color: var(--text-muted);
  }
  .mobile-navigation__number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    letter-spacing: 0;
  }
  .mobile-navigation__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
    margin-top: var(--space-32);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  .mobile-navigation__social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 44px;
    text-decoration: none;
  }
  :global(.mobile-dialog) {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-16);
    border: 0;
    background: rgb(var(--midnight-950-rgb) / 0.86);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    color: var(--text-primary);
  }
  :global(.mobile-dialog::backdrop) {
    background: rgb(var(--midnight-950-rgb) / 0.8);
  }
  :global(.mobile-dialog) .mobile-navigation__panel {
    width: 100%;
    max-width: 680px;
    margin: auto;
    min-height: calc(100svh - var(--space-32));
    background: transparent;
    border: 0;
    padding: var(--space-16);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  :global(.mobile-dialog) .mobile-navigation__top {
    margin-top: 0;
  }
  @media (min-width: 48rem) {
    .mobile-navigation {
      display: none;
    }
  }
</style>

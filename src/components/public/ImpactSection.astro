---
import type { HomeModel } from '../../lib/content/home.ts';
import SectionIntro from './SectionIntro.astro';
interface Props {
  home: HomeModel;
}
const { home } = Astro.props;
---

{
  home.metrics.length > 0 && (
    <section
      id="impacto"
      class="home-section container"
      aria-labelledby="impact-title"
      data-section="impact"
    >
      <>
        <SectionIntro
          eyebrow="Impacto"
          number="06"
          title="El resultado también importa."
          id="impact-title"
        />
        <div class="impact-grid">
          {home.metrics.map((metric) => (
            <article data-reveal>
              <p class="impact-value">{metric.value}</p>
              <h3>{metric.label}</h3>
              {metric.description && <p class="impact-description">{metric.description}</p>}
            </article>
          ))}
        </div>
      </>
    </section>
  )
}
<style>
  .impact-grid {
    display: grid;
    gap: var(--space-32);
  }
  .impact-grid article {
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  .impact-value {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 6rem);
    letter-spacing: -0.06em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: var(--space-16);
  }
  .impact-grid h3 {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-cyan);
  }
  .impact-description {
    margin-top: var(--space-16);
    font-size: 0.8125rem;
    color: var(--text-muted);
    max-width: 34ch;
  }
  @media (min-width: 40rem) {
    .impact-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
</style>

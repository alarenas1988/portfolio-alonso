---
import type { HomePost } from '../../lib/content/home.ts';
import type { AssetMap } from '../../lib/media/build-assets.ts';
import MediaImage from '../shared/MediaImage.astro';
interface Props {
  post: HomePost;
  assets: AssetMap;
  featured?: boolean;
}
const { post, assets, featured = false } = Astro.props;
---

<article class:list={['blog-card', { 'blog-card--featured': featured }]} data-blog-card data-reveal>
  {
    post.imageId && (
      <div class="blog-card__image">
        <MediaImage
          assets={assets}
          assetId={post.imageId}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        />
      </div>
    )
  }<div class="blog-card__meta technical-label">
    <time datetime={post.row.published_at!}>{post.date}</time>{
      (<span>{post.readingTime} min de lectura</span>)
    }
  </div>{
    post.categories.length > 0 && (
      <p class="blog-card__category">{post.categories.map((row) => row.name).join(' · ')}</p>
    )
  }<h3><a href={post.href}>{post.row.title}</a></h3>{
    post.row.excerpt && <p class="blog-card__excerpt">{post.row.excerpt}</p>
  }
  <a class="text-link" href={post.href}
    >Leer insight <span aria-hidden="true">→</span><span class="sr-only">: {post.row.title}</span
    ></a
  >
</article>
<style>
  .blog-card > .text-link {
    min-height: 48px;
  }
  .blog-card.blog-card--featured h3 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    max-width: 20ch;
  }
  .blog-card h3 a {
    text-decoration: none;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .blog-card--featured {
      grid-template-columns: 1.2fr 1fr;
      column-gap: var(--space-48);
    }
    .blog-card--featured .blog-card__image {
      grid-row: span 6;
      margin: 0;
    }
    .blog-card--featured .blog-card__image :global(img) {
      height: 100%;
      min-height: 360px;
    }
  }
  .blog-card {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: var(--space-16);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  .blog-card__image {
    overflow: hidden;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
  }
  .blog-card__image :global(img) {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    font-size: 0.5625rem;
    letter-spacing: 0.02em;
  }
  .blog-card__category {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
  }
  .blog-card h3 {
    font-size: clamp(1.3rem, 2vw, 1.625rem);
    line-height: 1.3;
  }
  .blog-card__excerpt {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>

---
import type { HomePost } from '../../lib/content/home.ts';
import type { AssetMap } from '../../lib/media/build-assets.ts';
import MediaImage from '../shared/MediaImage.astro';
interface Props {
  post: HomePost;
  assets: AssetMap;
}
const { post, assets } = Astro.props;
---

<article class="blog-card" data-blog-card data-reveal>
  {
    post.imageId && (
      <div class="blog-card__image">
        <MediaImage
          assets={assets}
          assetId={post.imageId}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        />
      </div>
    )
  }<div class="blog-card__meta technical-label">
    <time datetime={post.row.published_at!}>{post.date}</time>{
      post.row.reading_time && <span>{post.row.reading_time} min de lectura</span>
    }
  </div>{
    post.categories.length > 0 && (
      <p class="blog-card__category">{post.categories.map((row) => row.name).join(' · ')}</p>
    )
  }<h3>{post.row.title}</h3>{
    post.row.excerpt && <p class="blog-card__excerpt">{post.row.excerpt}</p>
  }
</article>
<style>
  .blog-card {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: var(--space-16);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  .blog-card__image {
    overflow: hidden;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
  }
  .blog-card__image :global(img) {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    font-size: 0.5625rem;
    letter-spacing: 0.02em;
  }
  .blog-card__category {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
  }
  .blog-card h3 {
    font-size: clamp(1.3rem, 2vw, 1.625rem);
    line-height: 1.3;
  }
  .blog-card__excerpt {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>

---
import BrandMark from '../shared/BrandMark.astro';
import Icon from '../shared/Icon.astro';
---

<figure class="hero-visual" aria-labelledby="hero-visual-caption">
  <div class="hero-visual__diagram" aria-hidden="true">
    <svg class="hero-visual__connections" viewBox="0 0 560 500" fill="none"
      ><path d="M78 76H280V140M490 145H390V218M95 388H205V280M456 420H310V330"></path><circle
        cx="280"
        cy="140"
        r="4"></circle><circle cx="390" cy="218" r="4"></circle><circle cx="205" cy="280" r="4"
      ></circle><circle cx="310" cy="330" r="4"></circle></svg
    >
    <span class="hero-node hero-node--automation"><Icon name="workflow" size={16} />Automation</span
    >
    <span class="hero-node hero-node--development"><Icon name="code" size={16} />Development</span>
    <span class="hero-node hero-node--data"><Icon name="database" size={16} />Data</span>
    <span class="hero-node hero-node--ai"><Icon name="brain" size={16} />AI</span>
    <div class="hero-terminal" data-glass="strong" data-tilt data-spotlight>
      <div class="hero-terminal__bar">
        <span class="hero-terminal__dots"><i></i><i></i><i></i></span><span>profile / al</span
        ><BrandMark size={18} variant="mono" />
      </div>
      <div class="hero-terminal__body">
        <p class="hero-terminal__command"><span>›</span> profile.initialize</p><dl>
          {
            ['automation', 'development', 'data', 'ai'].map((label) => (
              <div>
                <>
                  <dt>{label}</dt>
                  <dd>
                    <span>●</span> ready
                  </dd>
                </>
              </div>
            ))
          }
        </dl><div class="hero-terminal__status">
          <span>status</span><strong>ONLINE<span class="terminal-cursor">_</span></strong>
        </div>
      </div>
    </div>
    <span class="hero-visual__coordinate">01 / HUMAN + TECHNOLOGY</span>
  </div>
  <figcaption id="hero-visual-caption">Un mapa conceptual de lo que me mueve.</figcaption>
</figure>
<style>
  .hero-visual {
    width: 100%;
    margin: 0;
    min-width: 0;
  }
  .hero-visual__diagram {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: auto;
    padding-block: var(--space-96) var(--space-80);
  }
  .hero-visual__connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--accent-cyan);
    stroke-width: 1;
    opacity: 0.32;
  }
  .hero-visual__connections circle {
    fill: var(--accent-cyan);
  }
  .hero-terminal {
    position: relative;
    margin-inline: auto;
    width: 78%;
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--glass-strong), var(--glass-subtle));
    box-shadow: var(--shadow-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    overflow: hidden;
  }
  .hero-terminal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding: var(--space-16) var(--space-24);
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }
  .hero-terminal__dots {
    display: flex;
    gap: 6px;
  }
  .hero-terminal__dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-subtle);
  }
  .hero-terminal__dots i:first-child {
    background: var(--accent-cyan);
    opacity: 0.8;
  }
  .hero-terminal__body {
    padding: var(--space-24);
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 1vw, 0.8125rem);
  }
  .hero-terminal__command {
    color: var(--text-primary);
    margin-bottom: var(--space-24);
  }
  .hero-terminal__command span {
    color: var(--accent-cyan);
    padding-right: var(--space-8);
  }
  dl {
    display: grid;
    gap: var(--space-12);
    margin: 0;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
  }
  dt {
    color: var(--text-muted);
  }
  dd {
    margin: 0;
    color: var(--accent-cyan);
  }
  dd span {
    font-size: 0.4375rem;
    vertical-align: middle;
    padding-right: var(--space-8);
  }
  .hero-terminal__status {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-24);
    padding-top: var(--space-16);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }
  .hero-terminal__status strong {
    color: var(--accent-cyan);
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .hero-node {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 34px;
    padding: var(--space-8) var(--space-12);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--midnight-850);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-secondary);
  }
  .hero-node :global(.icon) {
    color: var(--accent-cyan);
  }
  .hero-node--automation {
    top: var(--space-24);
    left: 2%;
  }
  .hero-node--development {
    top: var(--space-48);
    right: 0;
    z-index: 1;
  }
  .hero-node--data {
    bottom: var(--space-32);
    left: 4%;
  }
  .hero-node--ai {
    bottom: var(--space-32);
    right: 4%;
  }
  .hero-node--ai :global(.icon) {
    color: var(--accent-violet);
  }
  .hero-visual__coordinate {
    position: absolute;
    bottom: var(--space-8);
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }
  figcaption {
    margin-top: var(--space-8);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.6875rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .terminal-cursor {
      animation: cursor-pulse 1.8s step-end 3;
    }
    @keyframes cursor-pulse {
      50% {
        opacity: 0;
      }
    }
  }
  @media (max-width: 47.99rem) {
    .hero-visual__diagram {
      max-width: 400px;
      padding-top: var(--space-80);
    }
    .hero-node--development {
      right: 0;
      top: var(--space-32);
    }
    .hero-terminal {
      width: 82%;
    }
    .hero-visual__coordinate {
      display: none;
    }
    .hero-terminal__body {
      padding: var(--space-16);
    }
    .hero-terminal__bar {
      padding: var(--space-12) var(--space-16);
    }
    dl {
      gap: var(--space-8);
    }
    .hero-terminal__command {
      margin-bottom: var(--space-16);
    }
  }
</style>

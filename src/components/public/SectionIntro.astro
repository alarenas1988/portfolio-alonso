---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
  number?: string;
  description?: string;
}
const { eyebrow, title, id, number, description } = Astro.props;
---

<div class="section-intro" data-reveal>
  <div class="section-intro__eyebrow technical-label">
    {number && <span aria-hidden="true">{number} /</span>}{eyebrow}
  </div><h2 id={id}>{title}</h2>{description && <p>{description}</p>}<slot />
</div>
<style>
  .section-intro {
    display: grid;
    gap: var(--space-16);
    max-width: 820px;
  }
  .section-intro__eyebrow {
    display: flex;
    gap: var(--space-12);
    color: var(--text-secondary);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }
  .section-intro__eyebrow span {
    color: var(--accent-cyan);
  }
  .section-intro h2 {
    font-size: var(--font-size-h2);
    max-width: 23ch;
  }
  .section-intro p {
    max-width: 58ch;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>

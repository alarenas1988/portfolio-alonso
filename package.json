{
  "name": "portfolio-alonso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.ts",
    "edge:check": "node scripts/check-edge-functions.mjs",
    "edge:bundle:local": "node scripts/check-edge-functions.mjs --bundle-local",
    "edge:lint": "deno lint supabase/functions",
    "test:edge": "deno test --config supabase/functions/deno.json supabase/functions/tests",
    "edge:serve": "node scripts/serve-edge-local.mjs",
    "test:edge:http": "node scripts/test-edge-http.mjs",
    "test:contact:local": "node scripts/test-contact-local.mjs",
    "test:analytics:local": "node scripts/test-analytics-local.mjs",
    "test:publishing:local": "node --experimental-transform-types scripts/test-publishing-local.mjs",
    "test:e2e": "playwright test",
    "test:home:build": "node scripts/test-home-build.mjs",
    "check:static": "node scripts/check-static-output.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:lint": "node scripts/supabase-local.mjs lint",
    "db:test": "node scripts/supabase-local.mjs test",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "db:snapshot:check": "node scripts/check-local-snapshot.mjs",
    "test:auth:local": "node scripts/test-local-auth.mjs",
    "db:audit": "node scripts/audit-local-security.mjs",
    "test:media:local": "node scripts/test-local-media.mjs",
    "test:storage:identity:local": "node scripts/probe-local-storage-identity.mjs",
    "db:baseline:generate": "node scripts/generate-baseline.mjs",
    "db:baseline:check": "node scripts/generate-baseline.mjs --check",
    "test:baseline:local": "node scripts/test-local-baseline.mjs",
    "db:baseline:review": "node scripts/review-initial-diff.mjs",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test:admin:upgrade": "node scripts/test-admin-upgrade-local.mjs",
    "check:admin:static": "node scripts/check-admin-static.mjs"
  },
  "dependencies": {
    "@lucide/astro": "1.41.0",
    "@supabase/supabase-js": "2.115.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "pdf-lib": "1.17.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@supabase/server": "1.5.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "deno": "2.9.6",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "deno@2.9.6": true
  }
}

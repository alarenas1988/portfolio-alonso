{
  "name": "portfolio-alonso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check:static": "node scripts/check-static-output.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:lint": "node scripts/supabase-local.mjs lint",
    "db:test": "node scripts/supabase-local.mjs test",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "db:snapshot:check": "node scripts/check-local-snapshot.mjs"
  },
  "dependencies": {
    "@lucide/astro": "1.41.0",
    "@supabase/supabase-js": "2.115.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

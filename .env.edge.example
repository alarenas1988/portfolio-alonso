# Reference for F9 only. Do not load this file into Astro.
# Supabase runtime provides URL and key dictionaries to @supabase/server.
# Managed runtime variables include SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS,
# SUPABASE_SECRET_KEYS and SUPABASE_JWKS; do not duplicate them in this file.
# SUPABASE_ACCESS_TOKEN belongs to CLI/deployment tooling, not Edge runtime code.
# Never place secret API keys in Authorization; use apikey.
GITHUB_FINE_GRAINED_TOKEN=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
ANALYTICS_HASH_SECRET=
RATE_LIMIT_HASH_SECRET=
BUILD_CALLBACK_SECRET=
EMAIL_PROVIDER_SECRET=
EMAIL_FROM=
EMAIL_TO=
ALLOWED_ORIGINS=
